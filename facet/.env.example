# Copy this file to .env (gitignored) and replace the placeholder passwords.
# The real test credentials are in 1Password under "FIREFLY- CET API test credentials".

# Users the API accepts: JSON object of username to password.
CET_API_USERS='{"alice":"alice-password","bob":"bob-pwd"}'

# Test login for curl or the /docs Authorize button. Must match a user above.
CET_TEST_USER=alice
CET_TEST_PASSWORD=alice-password
